# ═══════════════════════════════════════════════════════════════════════════
# HR Web App - Environment Configuration
# Copy this file to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════════════════════

# ─── FLASK ──────────────────────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-change-this-in-production-use-a-long-random-string

# ─── DATABASE (Supabase - RECOMMENDED FOR CLOUD) ────────────────────────────
# PRIMARY METHOD: Use Supabase DATABASE_URL
# Get from Supabase Dashboard: Project Settings → Database → Connection String
# Select "Session mode" or "URI" (not Connection Pooler for direct connection)
# Format: postgresql://postgres:PASSWORD@host:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@addyskbgjhqmzrseqvnh.supabase.co:5432/postgres

# ─── DATABASE (Alternative: Individual Parameters) ─────────────────────────
# Only used if DATABASE_URL is NOT set
# Remove DATABASE_URL above and uncomment these to use individual params:
# DB_HOST=addyskbgjhqmzrseqvnh.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=YOUR_PASSWORD

# ─── LOCAL DEVELOPMENT FALLBACK ──────────────────────────────────────────────
# When online DB fails, try local PostgreSQL
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=hr_system
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=postgres

# ─── EMAIL CONFIGURATION ────────────────────────────────────────────────────
# Gmail SMTP (recommended for testing)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password-16-chars
SUPPORT_EMAIL=support@yourcompany.com

# Alternative: SendGrid
# SMTP_SERVER=smtp.sendgrid.net
# SMTP_PORT=587
# SENDER_EMAIL=apikey
# SENDER_PASSWORD=SG.your-sendgrid-api-key

# Alternative: Office 365
# SMTP_SERVER=smtp.office365.com
# SMTP_PORT=587
# SENDER_EMAIL=your-email@company.com
# SENDER_PASSWORD=your-password

# ─── APPLICATION SETTINGS ───────────────────────────────────────────────────
APP_NAME=HR Core
DEBUG=False
PORT=5000

# ─── RENDER DEPLOYMENT ──────────────────────────────────────────────────────
# Set DATABASE_URL in Render Dashboard → Environment
# Render automatically sets: RENDER=true, PORT
